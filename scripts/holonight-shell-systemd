#!/usr/bin/env bash
set -euo pipefail

warn() {
  printf 'holonight-shell-systemd: warning: %s\n' "$*" >&2
}

have_command() {
  command -v "$1" >/dev/null 2>&1
}

systemd_environment() {
  systemctl --user show-environment 2>/dev/null || true
}

environment_value() {
  local name="$1"
  local output="$2"

  printf '%s\n' "${output}" | sed -n "s/^${name}=//p" | head -n 1
}

import_runtime_environment() {
  local output="$1"
  local compositor="$2"
  local name
  local value
  local allowed=(
    WAYLAND_DISPLAY
    DISPLAY
    XDG_CURRENT_DESKTOP
    XDG_SESSION_DESKTOP
    XDG_SESSION_TYPE
    XDG_MENU_PREFIX
    XDG_DATA_DIRS
    XDG_CONFIG_DIRS
    DBUS_SESSION_BUS_ADDRESS
    HYPRLAND_INSTANCE_SIGNATURE
    HYPRLAND_CMD
    SWAYSOCK
    I3SOCK
    QT_QPA_PLATFORM
    QT_QPA_PLATFORMTHEME
    QT_QUICK_CONTROLS_STYLE
    XCURSOR_THEME
    XDG_CONFIG_HOME
    HOLONIGHT_APPEARANCE_FILE
  )

  for name in "${allowed[@]}"; do
    value="$(environment_value "${name}" "${output}")"
    if [[ -n "${value}" ]]; then
      export "${name}=${value}"
    fi
  done
  if [[ "${compositor}" == sway ]]; then
    unset HYPRLAND_INSTANCE_SIGNATURE HYPRLAND_CMD
  else
    unset SWAYSOCK I3SOCK
  fi
}

selected_compositor() {
  local desktops="$1"
  local desktop

  IFS=':' read -r -a desktop_tokens <<<"${desktops}"
  for desktop in "${desktop_tokens[@]}"; do
    case "${desktop,,}" in
      hyprland) printf 'hyprland\n'; return ;;
      sway) printf 'sway\n'; return ;;
    esac
  done
  return 1
}

wait_for_compositor_environment() {
  local timeout="${HOLONIGHT_SHELL_SYSTEMD_ENV_TIMEOUT:-60}"
  local deadline=$((SECONDS + timeout))
  local output
  local wayland_display
  local hyprland_signature
  local sway_socket
  local compositor

  if ! have_command systemctl; then
    warn "systemctl is not installed; starting with inherited environment"
    return 0
  fi

  while (( SECONDS <= deadline )); do
    output="$(systemd_environment)"
    wayland_display="$(environment_value WAYLAND_DISPLAY "${output}")"
    hyprland_signature="$(environment_value HYPRLAND_INSTANCE_SIGNATURE "${output}")"
    sway_socket="$(environment_value SWAYSOCK "${output}")"
    compositor="$(selected_compositor "$(environment_value XDG_CURRENT_DESKTOP "${output}")" || true)"

    if [[ -n "${wayland_display}" ]] && { [[ "${compositor}" == sway && -n "${sway_socket}" ]] ||
         [[ "${compositor}" == hyprland && -n "${hyprland_signature}" ]]; }; then
      import_runtime_environment "${output}" "${compositor}"
      return 0
    fi

    sleep 0.2
  done

  warn "timed out waiting for WAYLAND_DISPLAY and the selected compositor marker"
  return 1
}

wait_for_compositor_environment
exec holonight-shell "$@"
