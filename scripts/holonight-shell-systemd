#!/usr/bin/env bash
set -euo pipefail

warn() {
  printf 'holonight-shell-systemd: warning: %s\n' "$*" >&2
}

shell_directory="$(cd -- "${BASH_SOURCE[0]%/*}" && pwd)"
state_helper="${HOLONIGHT_SESSION_STATE_HELPER:-${shell_directory}/holonight-session-state}"
declare -A manager=()
read_manager() {
  local entry
  local -a entries=()
  mapfile -d '' -t entries < <("$state_helper" environment && printf '%s\0' complete)
  (( ${#entries[@]} > 0 )) || return 1
  [[ "${entries[-1]}" == complete ]] || return 1
  manager=()
  for entry in "${entries[@]:0:${#entries[@]}-1}"; do
    manager["${entry%%=*}"]="${entry#*=}"
  done
}
import_runtime_environment() {
  local name
  for name in WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE XDG_MENU_PREFIX XDG_DATA_DIRS XDG_CONFIG_DIRS DBUS_SESSION_BUS_ADDRESS HYPRLAND_INSTANCE_SIGNATURE HYPRLAND_CMD SWAYSOCK LABWC_PID I3SOCK QT_QPA_PLATFORM QT_QPA_PLATFORMTHEME QT_QUICK_CONTROLS_STYLE XCURSOR_THEME XDG_CONFIG_HOME HOLONIGHT_APPEARANCE_FILE HOLONIGHT_LABWC_CONFIG_DIR; do
    unset "$name"
    [[ ! -v manager[$name] ]] || export "$name=${manager[$name]}"
  done
  case "$1" in
    sway) unset HYPRLAND_INSTANCE_SIGNATURE HYPRLAND_CMD LABWC_PID ;;
    labwc) unset HYPRLAND_INSTANCE_SIGNATURE HYPRLAND_CMD SWAYSOCK I3SOCK ;;
    *) unset SWAYSOCK I3SOCK LABWC_PID ;;
  esac
}

selected_compositor() {
  local desktops="$1"
  local desktop

  IFS=':' read -r -a desktop_tokens <<<"${desktops}"
  for desktop in "${desktop_tokens[@]}"; do
    case "${desktop,,}" in
      hyprland) printf 'hyprland\n'; return ;;
      sway) printf 'sway\n'; return ;;
      labwc) printf 'labwc\n'; return ;;
    esac
  done
  return 1
}

wait_for_compositor_environment() {
  local timeout="${HOLONIGHT_SHELL_SYSTEMD_ENV_TIMEOUT:-60}"
  local deadline=$((SECONDS + timeout))
  local wayland_display
  local hyprland_signature
  local labwc_pid
  local sway_socket
  local compositor

  while (( SECONDS <= deadline )); do
    if ! read_manager; then
      warn "cannot verify manager environment"
      return 1
    fi
    wayland_display="${manager[WAYLAND_DISPLAY]-}"
    hyprland_signature="${manager[HYPRLAND_INSTANCE_SIGNATURE]-}"
    labwc_pid="${manager[LABWC_PID]-}"
    sway_socket="${manager[SWAYSOCK]-}"
    compositor="$(selected_compositor "${manager[XDG_CURRENT_DESKTOP]-}" || true)"

    if [[ -n "${wayland_display}" ]] && { [[ "${compositor}" == sway && -n "${sway_socket}" ]] ||
         [[ "${compositor}" == hyprland && -n "${hyprland_signature}" ]] ||
         [[ "${compositor}" == labwc && "${labwc_pid}" =~ ^([2-9]|[1-9][0-9]+)$ ]]; }; then
      import_runtime_environment "${compositor}"
      return 0
    fi

    sleep 0.2
  done

  warn "timed out waiting for WAYLAND_DISPLAY and the selected compositor marker"
  return 1
}

wait_for_compositor_environment
shell_directory="$(cd -- "${BASH_SOURCE[0]%/*}" && pwd)"
exec "${HOLONIGHT_SHELL_EXECUTABLE:-${shell_directory}/holonight-shell}" "$@"
