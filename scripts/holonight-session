#!/usr/bin/env bash
set -euo pipefail

die() { printf 'holonight-session: error: %s\n' "$*" >&2; exit 1; }
warn() { printf 'holonight-session: warning: %s\n' "$*" >&2; }
have_command() { command -v "$1" >/dev/null 2>&1; }

reconcile_appearance() {
  local appearance_file
  if ! have_command holonight-appearance-adapter; then
    return
  fi
  if ! have_command timeout; then
    warn "timeout is unavailable; appearance reconciliation was skipped"
    return
  fi
  if ! appearance_file="$(resolve_appearance_file)"; then
    warn "canonical appearance path is unavailable; appearance reconciliation was skipped"
    return
  fi
  if ! timeout 15s holonight-appearance-adapter apply --appearance "${appearance_file}" --json >/dev/null; then
    warn "appearance reconciliation failed; session startup will continue"
  fi
}

[[ $# -eq 1 ]] || die "expected compositor hyprland, sway, or labwc"
compositor="$1"
case "${compositor}" in hyprland|sway|labwc) ;; *) die "expected compositor hyprland, sway, or labwc" ;; esac

if [[ "${compositor}" == hyprland ]]; then
  executable=Hyprland
  desktop=Hyprland
  menu_prefix=hyprland-
  stale_vars=(SWAYSOCK I3SOCK LABWC_PID)
elif [[ "${compositor}" == sway ]]; then
  executable=sway
  desktop=sway
  menu_prefix=sway-
  stale_vars=(HYPRLAND_INSTANCE_SIGNATURE HYPRLAND_CMD LABWC_PID)
else
  executable=labwc
  desktop=labwc
  menu_prefix=labwc-
  stale_vars=(HYPRLAND_INSTANCE_SIGNATURE HYPRLAND_CMD SWAYSOCK I3SOCK)
fi

script_directory="$(cd -- "${BASH_SOURCE[0]%/*}" && pwd)"
defaults="@CMAKE_INSTALL_FULL_DATADIR@/holonight/session/holonight-session-defaults"
[[ "$defaults" != '@'* ]] || defaults="$script_directory/holonight-session-defaults"
. "$defaults"
have_command "${executable}" || die "${executable} was not found in PATH"
unset "${stale_vars[@]}"
case "$compositor" in
  hyprland) identity=HoloNight-Hyprland:HoloNight:Hyprland ;;
  sway) identity=HoloNight-Sway:HoloNight:sway ;;
  labwc) identity=HoloNight-Labwc:HoloNight:labwc ;;
esac
export XDG_CURRENT_DESKTOP="$identity"
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-${desktop}}"
export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-wayland}"
export XDG_MENU_PREFIX="${XDG_MENU_PREFIX:-${menu_prefix}}"
mode="${HOLONIGHT_SESSION_MODE:-auto}"
case "$mode" in
  auto|uwsm)
    have_command uwsm || die "managed sessions require UWSM; install uwsm or explicitly select HOLONIGHT_SESSION_MODE=direct"
    have_command systemctl || die "managed sessions require systemd"
    [[ "${XDG_SESSION_ID:-}" =~ ^[A-Za-z0-9_.-]+$ ]] || die "a valid logind XDG_SESSION_ID is required"
    systemctl --user show-environment >/dev/null || die "systemd user manager is unavailable"
    for unit in holonight-shell.service holonight-polkit-agent@.service; do
      systemctl --user cat "$unit" >/dev/null 2>&1 || die "missing user unit $unit; reinstall holonight-shell and reload user units"
    done
    uwsm check may-start -i -g 0 0 || die "a new graphical session cannot start; log out of the existing session first"
    for helper in flock python3 holonight-shell holonight-shell-systemd holonight-session-finalize holonight-session-config; do
      have_command "$helper" || die "missing $helper; reinstall holonight-shell"
    done
    [[ "$compositor" != hyprland ]] || have_command start-hyprland || die "install start-hyprland"
    [[ -n "${XDG_RUNTIME_DIR:-}" && -d "$XDG_RUNTIME_DIR" && -O "$XDG_RUNTIME_DIR" ]] || die "a user-owned XDG_RUNTIME_DIR is required"
    for backend in holonight holonight-filechooser gtk "$([[ "$compositor" == hyprland ]] && echo hyprland || echo wlr)"; do
      found=false
      IFS=: read -r -a data_dirs <<<"$XDG_DATA_DIRS"
      for directory in "${data_dirs[@]}"; do
        [[ ! -f "$directory/xdg-desktop-portal/portals/$backend.portal" ]] || found=true
      done
      "$found" || warn "portal backend $backend is missing; install its xdg-desktop-portal package for full desktop capabilities"
    done
    systemctl --user cat xdg-desktop-portal.service >/dev/null 2>&1 || warn "install xdg-desktop-portal for desktop portals"
    config="$(holonight-session-config "$compositor")" || die "could not prepare managed configuration"
    if [[ "$compositor" == labwc ]]; then
      export HOLONIGHT_SESSION_RUN_DIR="$config"
    else
      export HOLONIGHT_SESSION_RUN_DIR="${config%/*}"
    fi
    export UWSM_WAIT_VARNAMES="${UWSM_WAIT_VARNAMES:+$UWSM_WAIT_VARNAMES }HOLONIGHT_SESSION_READY"
    unset HOLONIGHT_SESSION_READY
    reconcile_appearance
    case "$compositor" in
      hyprland) exec uwsm start -e -D "$identity" -- start-hyprland -- --config "$config" ;;
      sway) exec uwsm start -e -D "$identity" -- sway --config "$config" ;;
      labwc) exec uwsm start -e -D "$identity" -- labwc --config-dir "$config" --startup 'holonight-session-finalize labwc' ;;
    esac
    ;;
  direct) ;;
  *) die "unknown HOLONIGHT_SESSION_MODE=${mode}; expected auto, uwsm, or direct" ;;
esac
# Direct integration retains the legacy portal layer and explicit activation import.
default_portal_dir="${installation_datadir}/holonight/xdg"
[[ "$defaults" != "$script_directory/holonight-session-defaults" ]] || default_portal_dir="${installation_datadir}/xdg"
portal_config_dir="${HOLONIGHT_PORTAL_CONFIG_DIR:-${default_portal_dir}}"
[[ "$portal_config_dir" == /* ]] || die "portal configuration directory must be absolute"
case ":${XDG_CONFIG_DIRS:-/etc/xdg}:" in
  *:"$portal_config_dir":*) ;; *) export XDG_CONFIG_DIRS="$portal_config_dir:${XDG_CONFIG_DIRS:-/etc/xdg}" ;;
esac
vars=(WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE XDG_MENU_PREFIX
  XDG_DATA_DIRS XDG_CONFIG_DIRS QML_IMPORT_PATH QT_PLUGIN_PATH QT_QPA_PLATFORM QT_QPA_PLATFORMTHEME QT_QUICK_CONTROLS_STYLE XCURSOR_THEME
  XDG_CONFIG_HOME HOLONIGHT_APPEARANCE_FILE SUDO_ASKPASS SSH_ASKPASS PATH)
if have_command dbus-update-activation-environment; then
  dbus_update_args=()
  for stale_var in "${stale_vars[@]}"; do
    dbus_update_args+=("${stale_var}=")
  done
  dbus-update-activation-environment --systemd "${dbus_update_args[@]}" || \
    warn "failed to clear stale compositor variables from D-Bus activation"
  dbus-update-activation-environment --systemd "${vars[@]}" || warn "failed to import D-Bus environment"
fi
if have_command systemctl; then
  systemctl --user unset-environment "${stale_vars[@]}" || warn "failed to clear stale systemd environment"
  systemctl --user import-environment "${vars[@]}" || warn "failed to import systemd environment"
fi

reconcile_appearance

exec "${executable}"
