#!/usr/bin/env bash
set -euo pipefail

warn() {
  printf 'holonight-hyprland-session: warning: %s\n' "$*" >&2
}

die() {
  printf 'holonight-hyprland-session: error: %s\n' "$*" >&2
  exit 1
}

have_command() {
  command -v "$1" >/dev/null 2>&1
}

import_environment() {
  local vars=(
    WAYLAND_DISPLAY
    DISPLAY
    XDG_CURRENT_DESKTOP
    XDG_SESSION_DESKTOP
    XDG_SESSION_TYPE
    XDG_MENU_PREFIX
    XDG_DATA_DIRS
    XDG_CONFIG_DIRS
    QT_QPA_PLATFORM
    QT_QPA_PLATFORMTHEME
    QT_QUICK_CONTROLS_STYLE
    XCURSOR_THEME
    XDG_CONFIG_HOME
    HOLONIGHT_APPEARANCE_FILE
  )

  if have_command dbus-update-activation-environment; then
    dbus-update-activation-environment --systemd "${vars[@]}" || \
      warn "failed to import environment into D-Bus activation"
  else
    warn "dbus-update-activation-environment is not installed"
  fi

  if have_command systemctl; then
    systemctl --user import-environment "${vars[@]}" || \
      warn "failed to import environment into systemd user manager"
  else
    warn "systemctl is not installed"
  fi
}

resolve_appearance_file() {
  if [[ -n "${HOLONIGHT_APPEARANCE_FILE:-}" ]]; then
    printf '%s\n' "${HOLONIGHT_APPEARANCE_FILE}"
  elif [[ -n "${XDG_CONFIG_HOME:-}" ]]; then
    printf '%s/holonight/appearance.toml\n' "${XDG_CONFIG_HOME}"
  elif [[ -n "${HOME:-}" ]]; then
    printf '%s/.config/holonight/appearance.toml\n' "${HOME}"
  else
    return 1
  fi
}

load_cursor_theme() {
  local appearance_file
  local output

  if ! have_command holonight-appearance-adapter; then
    warn "holonight-appearance-adapter is not installed; preserving inherited XCURSOR_THEME"
    return 0
  fi
  if ! appearance_file="$(resolve_appearance_file)"; then
    warn "canonical appearance path is unavailable; preserving inherited XCURSOR_THEME"
    return 0
  fi
  if ! output="$(holonight-appearance-adapter query --appearance "${appearance_file}" --field cursor-theme)"; then
    warn "cursor theme query failed; preserving inherited XCURSOR_THEME"
    return 0
  fi
  if [[ -z "${output}" || ${#output} -gt 4096 || "${output}" == *$'\n'* || "${output}" =~ [[:cntrl:]] ]]; then
    warn "cursor theme query returned invalid output; preserving inherited XCURSOR_THEME"
    return 0
  fi
  export XCURSOR_THEME="${output}"
}

start_shell_service() {
  if have_command systemctl; then
    systemctl --user daemon-reload || \
      warn "failed to reload systemd user units"
    systemctl --user start holonight-shell.service || \
      warn "failed to queue holonight-shell.service"
  else
    warn "systemctl is not installed; holonight-shell.service cannot be started automatically"
  fi
}

export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-HoloNight:Hyprland}"
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-Hyprland}"
export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-wayland}"
export XDG_MENU_PREFIX="${XDG_MENU_PREFIX:-hyprland-}"
export QT_QPA_PLATFORMTHEME="${QT_QPA_PLATFORMTHEME:-holonight}"
export QT_QUICK_CONTROLS_STYLE="${QT_QUICK_CONTROLS_STYLE:-Holonight}"

have_command Hyprland || die "Hyprland was not found in PATH"

load_cursor_theme
import_environment

mode="${HOLONIGHT_HYPRLAND_SESSION_MODE:-auto}"
case "${mode}" in
  auto)
    if have_command uwsm; then
      start_shell_service
      exec uwsm start -e -D Hyprland hyprland.desktop
    fi
    exec Hyprland
    ;;
  uwsm)
    have_command uwsm || die "HOLONIGHT_HYPRLAND_SESSION_MODE=uwsm was requested, but uwsm was not found in PATH"
    start_shell_service
    exec uwsm start -e -D Hyprland hyprland.desktop
    ;;
  direct)
    exec Hyprland
    ;;
  *)
    die "unknown HOLONIGHT_HYPRLAND_SESSION_MODE=${mode}; expected auto, uwsm, or direct"
    ;;
esac
