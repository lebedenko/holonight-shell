{
  "module": "holonight-shell",
  "cpp": true,
  "qml": true,
  "languages": [
    "cpp",
    "qml",
    "python",
    "bash"
  ],
  "dependencies": [
    {
      "module": "holonight-config",
      "package": "HoloNightConfig",
      "source_variable": "HOLONIGHT_CONFIG_SOURCE"
    },
    {
      "module": "holonight-system-services",
      "package": "HoloNightSystemServices",
      "source_variable": "HOLONIGHT_SYSTEM_SERVICES_SOURCE"
    },
    {
      "module": "holonight-qt",
      "package": "HolonightQt",
      "source_variable": "HOLONIGHT_QT_SOURCE"
    }
  ],
  "qml_modules": [
    "HolonightShell"
  ],
  "wayland": true,
  "test_command_prefix": [
    "python3",
    "scripts/run-isolated-test.py",
    "--hide-host"
  ],
  "external_dependencies": [
    {
      "id": "qt",
      "scope": [
        "build"
      ],
      "components": [
        "Core",
        "Gui",
        "Quick",
        "Qml",
        "DBus",
        "Network",
        "Concurrent",
        "Sql",
        "QuickControls2",
        "WaylandClient",
        "WaylandClientPrivate"
      ]
    },
    {
      "id": "qt-wayland",
      "scope": [
        "build"
      ]
    },
    {
      "id": "wayland",
      "scope": [
        "build"
      ]
    },
    {
      "id": "wayland-protocols",
      "scope": [
        "build"
      ]
    },
    {
      "id": "wayland-scanner",
      "scope": [
        "build"
      ]
    },
    {
      "id": "toml",
      "scope": [
        "build"
      ],
      "discovery": "pkg-config",
      "package": "tomlplusplus"
    },
    {
      "id": "secret",
      "scope": [
        "build"
      ]
    },
    {
      "id": "polkit",
      "scope": [
        "build"
      ]
    },
    {
      "id": "polkit-qt-agent",
      "scope": [
        "build"
      ]
    },
    {
      "id": "polkit-qt-core",
      "scope": [
        "build"
      ]
    },
    {
      "id": "udisks",
      "scope": [
        "runtime"
      ]
    },
    {
      "id": "bwrap",
      "scope": [
        "test"
      ]
    },
    {
      "id": "sway",
      "scope": [
        "test"
      ]
    },
    {
      "id": "dbus",
      "scope": [
        "test"
      ]
    },
    {
      "id": "compiler",
      "scope": [
        "tool"
      ]
    },
    {
      "id": "cmake",
      "scope": [
        "tool"
      ]
    },
    {
      "id": "ninja",
      "scope": [
        "tool"
      ]
    },
    {
      "id": "pkgconf",
      "scope": [
        "tool"
      ]
    },
    {
      "id": "git",
      "scope": [
        "tool"
      ]
    },
    {
      "id": "python",
      "scope": [
        "tool"
      ]
    },
    {
      "id": "gtest",
      "scope": [
        "test"
      ],
      "targets": [
        "GTest::gmock",
        "GTest::gtest"
      ]
    },
    {
      "id": "qt",
      "scope": [
        "test"
      ],
      "components": [
        "Test",
        "QuickTest"
      ]
    },
    {
      "id": "fonts",
      "scope": [
        "runtime"
      ]
    },
    {
      "id": "mime",
      "scope": [
        "runtime"
      ]
    }
  ],
  "external_features": {}
